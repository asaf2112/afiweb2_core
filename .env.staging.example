# ==============================================================================
#  AFI BİLİŞİM — CANLI TEST (STAGING) VE CANLI ORTAM KONFİGÜRASYON ŞABLONU (.env)
# ==============================================================================

APP_NAME="Afi Bilişim Teknolojileri"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.afibilisim.com
ASSET_URL=https://staging.afibilisim.com

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# VERİTABANI BAĞLANTISI (MySQL Canlı / Staging DB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afibilisim_staging_db
DB_USERNAME=afibilisim_db_user
DB_PASSWORD=SecureStagingPassword123!

# ------------------------------------------------------------------------------
# CANLI MAİL YAPILANDIRMASI (Gmail SMTP / App Password Entegrasyonu)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=destek.afibilisim@gmail.com
MAIL_PASSWORD="xxxx xxxx xxxx xxxx" # Gmail Uygulama Şifresi (App Password)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="destek.afibilisim@gmail.com"
MAIL_FROM_NAME="${APP_NAME} Canlı Destek"

# ------------------------------------------------------------------------------
# LAVOX TOPTANCI INTEGRATION CONFIGURATION
# ------------------------------------------------------------------------------
LAVOX_API_URL="https://api.lavox.com.tr/v1/products"
LAVOX_API_KEY="lavox_live_api_token_here"
LAVOX_PROFIT_MARGIN=15 # Toptan fiyata eklenecek % kar marjı

# ------------------------------------------------------------------------------
# GÜVENLİK VE GÜVENLİ HTTPS YÖNLENDİRME
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
FORCE_HTTPS=true
